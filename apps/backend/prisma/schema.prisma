generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  email        String   @unique
  senha        String   
  createdAt    DateTime @default(now())
  ativo        Boolean
  autenticacao Boolean
  telefone     String   @db.Char(14)
  imagem       String 
  perfis       Perfil[]
}

model Perfil {
  id          Int       @id @default(autoincrement())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  usuarioId   Usuario   @relation(fields: [usuario], references: [id])
  usuario     Int
  permissoes  Permissao[]
  
}

model Permissao {
  id          Int       @id @default(autoincrement())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  perfilId    Perfil    @relation(fields: [perfil], references: [id])
  perfil      Int
}