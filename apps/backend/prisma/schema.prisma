generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String   @db.VarChar(100)
  apelido      String   @db.VarChar(30)
  email        String   @unique
  senha        String   
  createdAt    DateTime @default(now())
  ativo        Boolean
  autenticacao Boolean
  telefone     String   @db.Char(14)
  imagem       String 
  perfis       Perfil[]

  @@map("usuario")
}

model Perfil {
  id          String       @id @default(uuid())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  usuario     Usuario[]
  Permissao   Permissao[]
}


model Permissao {
  id          String    @id @default(uuid())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  perfis      Perfil[]

}