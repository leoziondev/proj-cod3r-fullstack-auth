// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String      @id @default(uuid())
  nome         String   @db.VarChar(100)
  apelido      String   @db.VarChar(30)
  email        String   @unique
  senha        String   
  createdAt    DateTime @default(now())
  ativo        Boolean
  autenticacao Boolean
  telefone     String   @db.Char(14)
  imagem       String 
  perfis       Perfil[]

  PerfisDosUsuarios PerfisDosUsuarios[]
}

model Perfil {
  id          String       @id @default(uuid())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  usuarios    PerfisDosUsuarios[]
  permissoes  PermissoesDosPerfis[]
  Usuario     Usuario[]
  Permissao   Permissao[]
}

model PerfisDosUsuarios {
  usuarioId  Usuario   @relation(fields: [usuario], references: [id])
  usuario    String
  perfilId   Perfil    @relation(fields: [perfil], references: [id])
  perfil     String

  @@id([usuario, perfil])
}

model Permissao {
  id          String      @id @default(uuid())
  tipo        String
  descricao   String    @db.VarChar(255)
  createdAt   DateTime  @default(now())
  ativo       Boolean
  perfis      Perfil[]

  PermissoesDosPerfis PermissoesDosPerfis[]
}

model PermissoesDosPerfis {
  perfilId    Perfil    @relation(fields: [perfil], references: [id])
  perfil      String
  permissaoId Permissao @relation(fields: [permissao], references: [id])
  permissao   String

  @@id([perfil, permissao])
}